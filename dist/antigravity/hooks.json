{
  "starcode-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{STARCODE_ROOT}}/hooks/scripts/git_guard.py\" --agy",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"{{STARCODE_ROOT}}/hooks/scripts/secret_scan.py\" --agy",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "starcode-banner": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python \"{{STARCODE_ROOT}}/hooks/scripts/banner.py\" --agy --cli antigravity",
        "timeout": 30
      }
    ]
  }
}
