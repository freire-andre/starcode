{
  "starcode-crew": {
    "PreToolUse": [
      {
        "matcher": "read_file|view_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python {{STARCODE_ROOT}}/hooks/scripts/crew_hook.py --cli antigravity",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python {{STARCODE_ROOT}}/hooks/scripts/crew_hook.py --cli antigravity",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python {{STARCODE_ROOT}}/hooks/scripts/crew_hook.py --cli antigravity",
            "timeout": 10
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python {{STARCODE_ROOT}}/hooks/scripts/crew_hook.py --cli antigravity",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python {{STARCODE_ROOT}}/hooks/scripts/crew_hook.py --cli antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "starcode-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python {{STARCODE_ROOT}}/hooks/scripts/git_guard.py --agy",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python {{STARCODE_ROOT}}/hooks/scripts/secret_scan.py --agy",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "starcode-banner": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python {{STARCODE_ROOT}}/hooks/scripts/banner.py --agy --full --cli antigravity",
        "timeout": 30
      }
    ]
  }
}
